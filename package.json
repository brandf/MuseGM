{
  "description": "Live Foundry VTT client library for Muse: sub-second chat wake-ups, chat send, dice, and world reads through the MIT laurigates MCP client (Socket.IO).",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "bun-types": "^1.4.5",
    "typescript": "5"
  },
  "name": "foundry-live",
  "private": true,
  "scripts": {
    "scene": "bun run src/cli/scene.ts",
    "send": "bun run src/cli/send.ts",
    "status": "bun run src/cli/status.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "dice": "bun run src/cli/dice.ts",
    "compendium": "bun run src/cli/compendium.ts",
    "loot": "bun run src/cli/loot.ts",
    "treasure": "bun run src/cli/treasure.ts",
    "remind": "bun run src/cli/remind.ts",
    "recap": "bun run src/cli/recap.ts",
    "qa": "bun run src/cli/qa.ts",
    "wait": "bun run src/cli/wait.ts",
    "move": "bun run src/cli/move.ts",
    "ping": "bun run src/cli/ping.ts",
    "sequence": "bun run src/cli/sequence.ts",
    "combat": "bun run src/cli/combat.ts",
    "encounter": "bun run src/cli/encounter.ts",
    "encounter-gen": "bun run src/cli/encounter-gen.ts",
    "monitor": "bun run src/cli/monitor.ts",
    "trap": "bun run src/cli/trap.ts",
    "cutscene": "bun run src/cli/cutscene.ts",
    "maze": "bun run src/cli/maze.ts"
  },
  "type": "module",
  "version": "0.1.0",
  "dependencies": {
    "axios": "^1.21.1"
  }
}